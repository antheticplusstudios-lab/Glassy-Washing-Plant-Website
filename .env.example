# Copy this file to .env for local development and fill in real values.
# In Hostinger hPanel, add these under the Node.js app's Environment Variables settings.

# --- Supabase (server-side, no VITE_ prefix — never sent to the browser) ---
SUPABASE_PROJECT_ID="nggafkyxyjuvqkubitcq"
SUPABASE_URL="https://nggafkyxyjuvqkubitcq.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Service-role key for admin operations (server functions that bypass RLS —
# sending replies, CSV export, user management). Get this from Supabase:
# Project Settings -> API -> service_role key. NEVER prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Supabase (client-side, VITE_ prefix — bundled into the browser build) ---
VITE_SUPABASE_PROJECT_ID="nggafkyxyjuvqkubitcq"
VITE_SUPABASE_URL="https://nggafkyxyjuvqkubitcq.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# --- Resend (transactional email for contact form + admin replies) ---
RESEND_API_KEY="your-resend-api-key"
# In Resend sandbox mode, this must match the email address registered to the
# Resend account behind RESEND_API_KEY. Set this explicitly in Hostinger.
RESEND_ACCOUNT_EMAIL="your-resend-account@example.com"
# Where contact-form notifications should go. In sandbox mode, use the same
# address as RESEND_ACCOUNT_EMAIL until glassywashing.com is verified in Resend.
BRIEF_NOTIFY_EMAIL="your-notification-inbox@example.com"
# Use Resend's onboarding sender for testing; production senders need a verified domain.
RESEND_FROM_EMAIL="Glassy Washing Plant <onboarding@resend.dev>"

# --- Optional: protects any cron-triggered server routes you add later ---
# CRON_SECRET="a-long-random-string"
# CRON_SECRET_PREVIOUS="the-previous-secret-during-rotation"

# Public production URL used for canonical tags and structured data.
VITE_SITE_URL="https://glassywashing.com"
