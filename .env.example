# Copy this file to .env for local development and fill in real values.
# In Vercel, add these under Project Settings -> Environment Variables instead.

# --- Supabase (server-side, no VITE_ prefix — never sent to the browser) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Service-role key for admin operations (server functions that bypass RLS —
# sending replies, CSV export, user management). Get this from Supabase:
# Project Settings -> API -> service_role key. NEVER prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Supabase (client-side, VITE_ prefix — bundled into the browser build) ---
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# --- Resend (transactional email for contact form + admin replies) ---
RESEND_API_KEY="your-resend-api-key"
# Optional fallback sender if site_content.site.contact.fromEmail isn't set:
# RESEND_FROM_EMAIL="Glassy Washing Plant <onboarding@resend.dev>"

# --- Optional: protects any cron-triggered server routes you add later ---
# CRON_SECRET="a-long-random-string"
# CRON_SECRET_PREVIOUS="the-previous-secret-during-rotation"
